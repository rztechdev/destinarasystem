{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "serve": "php artisan serve --port=8031",
        "all": "concurrently -n laravel,vite \"php artisan serve --port=8031\" \"vite\"",
        "all:host": "concurrently -n laravel,vite \"php artisan serve --host=0.0.0.0 --port=8031\" \"vite --host\""
    },
    "dependencies": {
        "alpinejs": "^3.14.8"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    }
}
